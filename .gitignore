# Dependencies
node_modules/

# Build output
/dist/

# Python caches
__pycache__/
*.pyc

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.playwright-mcp/

# Vendored Claude skill tooling (regenerable from skills-lock.json)
/.agents/

# Secrets — CDS API credentials. NEVER commit.
.cdsapirc

# Screenshots / scratch images at repo root (not committed assets under frontend/)
/*.png

# ERA5 data outputs (large, regenerable from the pipeline)
/data/era5_deprecated/
/data/era5-land/

# Debias tables — ~400MB local mirrors of the versioned R2 debias-vN/ tiers
# (regenerable via debias/make_debias_tables.py; the canonical copy
# lives on R2). Covers debias/, debias-v9/, debias-v10/, … and retired copies.
/debias/data/debias*/
# Kept pre-flip frontend build = one-command rollback (wrangler pages deploy dist-v7)
/dist-v*/

# Retired v1 per-location cache (cacheManager.js, superseded by v2 tiered serving)
/cache/
/cache_deprecated/

# R2 S3 API credentials (S3 access key/secret). NEVER commit.
/era5_pipeline/r2.env

# Cloudflare Analytics API token + zone id. NEVER commit.
/analytics/cloudflare.env

.wrangler/

# WSL "downloaded from the internet" sidecars
*:Zone.Identifier

# Local Claude Code config + worktree checkouts (machine-specific), except the
# shared hook config, which is the same in all six repos and belongs in a diff
# (coo#55). The directory itself must stay un-excluded for the negation to be
# reachable: git cannot re-include a file under an excluded directory.
/.claude/*
!/.claude/settings.json
!/.claude/skills/

# Ad-hoc analytics scratch: a root-level notebook and the raw hit exports
# that analytics/report.py pulls from Cloudflare.
/anaytics.ipynb
/hhwi-hits*.csv

# Local config backups (Claude Code state, not project files)
/backups/
