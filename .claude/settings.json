{
  "env": {
    "FORCE_HYPERLINK": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/tree-watch pre >/dev/null 2>&1; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/tree-watch start >/dev/null 2>&1; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/eta-ping 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/eta-ping 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "/home/ita/coo/tools/orchestrate-status statusline",
    "type": "command",
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "command": "/home/ita/coo/tools/orchestrate-status subagent-statusline",
    "type": "command"
  }
}
