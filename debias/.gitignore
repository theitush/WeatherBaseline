# The full 10k-cell HRES forecast pull lives in R2 (hres-forecast/ prefix), not
# git — pull_hres_all.py mirrors it here only as a local cache / resume aid.
# (The small pilot data/ — archive/ + overlap.csv — IS tracked, intentionally.)
data/hres-forecast/

# Raw CDS ERA5-Land geopotential GRIB (~13 MB) — regenerable; the derived
# cell_elevation.csv (small) IS tracked instead.
data/geo.grib

# Trained model cache (2+ GB after the full-grid VM run) — synced from the box
# or refit via train_quantile_debias.py, never tracked.
models/
catboost_info/

# Full-grid archive-overlap slices — local mirror, rebuildable with
# pull_archive_slice.py (R2) or rsync from the training box.
data/archive-overlap/

# Open-Meteo IFS-HRES forecast pull, version-pinned rebuild of data/hres-forecast/
# (8.8k files) — local cache of the R2 copy, same rule as above.
data/hres-forecast-ifs-hres/

# Notebook-exploration data mirrors: full archive sample (318 MB) and the
# confidence-validation frames (505 MB). Rebuildable from the pipeline / R2.
data/archive-full-sample/
data/nb_confidence/
data/pipeline_frame_full.feather

# cfgrib index sidecars
*.grib.*.idx

# Editing snapshots (notebooks + feathers) kept beside their originals
*.bak*
